# Production build settings. Loaded by `next build` / `next start` (NODE_ENV=production).
# Only public values live here: NEXT_PUBLIC_* is baked into the JavaScript bundle at BUILD time,
# so rebuild/redeploy after changing it. Never put secrets in this file (it is committed).
# Variables set in your host's dashboard (Vercel, Netlify...) override these.

# Base URL of the deployed Express API (https, no trailing slash).
NEXT_PUBLIC_API_URL=https://the-people-backend.onrender.com

# Public URL of the deployed site. Used for Open Graph, canonical URLs, sitemap.xml and robots.txt.
# TODO: replace with your real site URL before deploying.
NEXT_PUBLIC_SITE_URL=https://your-domain.com
